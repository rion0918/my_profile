{
  "name": "rion-hashimoto-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/secure-static-export.mjs --check-public && astro build && node scripts/secure-static-export.mjs",
    "start": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "security:audit": "npm audit --audit-level=low",
    "test:static": "node scripts/verify-static-build.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.4.5",
    "polygon-clipping": "^0.15.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.186.1"
  },
  "overrides": {
    "postcss": "8.5.31",
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "oxc-transform-react": "0.145.0",
    "typescript": "^5.5.3"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
