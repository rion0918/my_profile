---
import type { Product } from "../../lib/products";
import OptimizedImage from "./OptimizedImage.astro";
import ProductActions from "./ProductActions.astro";
interface Props { product: Product; }
const { product } = Astro.props;
---

    <div class={`productDetail product-${product.slug}`}>
      <div class="productHero">
        <div class="productIntroduction">
          {(product.team || product.status) && <p class="productByline">{product.team ?? product.status}</p>}
          <p class="productLead">{product.summary}</p>
          <ProductActions product={product} />
          {product.mediaNote && <p class="productMediaNote">{product.mediaNote}</p>}
        </div>
        {product.media && <section class="productShowcase" aria-label={`${product.name}のアプリ画面`}>
          {product.media.map((media) => <figure>
            <a href={media.src} target="_blank" rel="noopener noreferrer" class="productScreen" aria-label={`${media.alt}。画像を拡大する`}>
              <OptimizedImage src={media.src} alt={media.alt} widths={[240, 480, 720, 1280]} sizes={product.slug === "pop-reminder" ? "(max-width: 760px) 36vw, 155px" : "(max-width: 760px) 86vw, 440px"} />
            </a>
            <figcaption>{media.caption}</figcaption>
          </figure>)}
        </section>}
      </div>
      {product.features.map((feature) => (
        <section>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </section>
      ))}
      <section>
        <h3>使用技術</h3>
        <div class="pillList">
          {product.technologies.map((tech) => (
            <span>{tech}</span>
          ))}
        </div>
      </section>
      {(product.audience || product.period || product.role) && (
        <dl>
          {[
            ["想定ユーザー", product.audience],
            ["開発期間", product.period],
            ["担当範囲", product.role],
          ]
            .filter(([, value]) => value)
            .map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
        </dl>
      )}
      {product.decisions && (
        <section>
          <h3>設計の考え方</h3>
          {product.decisions.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      )}
      {product.outcomes && (
        <section>
          <h3>成果と学び</h3>
          {product.outcomes.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      )}
      {product.sourceLink && <a class="textLink" href={product.sourceLink.href} target="_blank" rel="noopener noreferrer">{product.sourceLink.label} ↗</a>}
    </div>
