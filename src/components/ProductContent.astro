---
import type { Product } from "../../lib/products";
import OptimizedImage from "./OptimizedImage.astro";
interface Props { product: Product; }
const { product } = Astro.props;
---

    <div class={`productDetail product-${product.slug}`}>
      <div class="productHero">
        <div class="productIntroduction">
          <p class="productLead">{product.summary}</p>
          {product.status && <p>{product.status}</p>}
          <p class="productPlatform">{product.technologies.slice(1, 3).join(" / ")}</p>
          {product.mediaNote && <p class="productMediaNote">{product.mediaNote}</p>}
        </div>
        {product.media && <section class="productShowcase" aria-label={`${product.name}のアプリ画面`}>
          {product.media.map((media) => <figure>
            <a href={media.src} target="_blank" rel="noopener noreferrer" class="productScreen" aria-label={`${media.alt}。画像を拡大する`}>
              <OptimizedImage src={media.src} alt={media.alt} widths={[240, 480, 720]} sizes="(max-width: 760px) 40vw, 180px" />
            </a>
            <figcaption>{media.caption}</figcaption>
          </figure>)}
        </section>}
      </div>
      {product.features.map((feature) => (
        <section>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </section>
      ))}
      <section>
        <h3>使用技術</h3>
        <div class="pillList">
          {product.technologies.map((tech) => (
            <span>{tech}</span>
          ))}
        </div>
      </section>
      {(product.audience || product.period || product.team || product.role) && (
        <dl>
          {[
            ["想定ユーザー", product.audience],
            ["開発期間", product.period],
            ["開発体制", product.team],
            ["担当範囲", product.role],
          ]
            .filter(([, value]) => value)
            .map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
        </dl>
      )}
      {product.decisions && (
        <section>
          <h3>設計の考え方</h3>
          {product.decisions.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      )}
      {product.outcomes && (
        <section>
          <h3>成果と学び</h3>
          {product.outcomes.map((text) => (
            <p>{text}</p>
          ))}
        </section>
      )}
      {!!product.links?.length && <div class="productLinks">{product.links.map((link) => (
        <a
          class="textLink"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label} ↗
        </a>
      ))}</div>}
    </div>
