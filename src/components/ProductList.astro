---
import { products } from "../../lib/products";
import OptimizedImage from "./OptimizedImage.astro";
import ProductActions from "./ProductActions.astro";
---
<div class="productList">
  {products.map(product => (
    <article class={`productFeature product-${product.slug}`}>
      <div>
        {(product.team || product.status) && <p class="productByline">{product.team ?? product.status}</p>}
        <h3>{product.name}</h3>
        <p class="productSummary">{product.summary}</p>
        <ProductActions product={product} showDetails />
      </div>
      <div class="productListPreview">
        {product.media?.slice(0, product.slug === "pop-reminder" ? 2 : 1).map(media =>
          <OptimizedImage src={media.src} alt={media.alt} widths={[180, 360, 640, 960]} sizes={product.slug === "pop-reminder" ? "120px" : "(max-width: 760px) 90vw, 440px"} />
        )}
      </div>
    </article>
  ))}
</div>
