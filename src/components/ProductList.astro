---
import { products } from "../../lib/products";
import OptimizedImage from "./OptimizedImage.astro";
---

    <div class="productList">
      {products.map((product, index) => (
        <a
          class="productLink"
          href={`/projects/${product.slug}`}
        >
          <span class="productNumber">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div>
            <h3>{product.name}</h3>
            <p>{product.summary}</p>
            <span class="textLink">作品を読む ↗</span>
          </div>
          {product.media?.[0] && <div class={`productListPreview product-${product.slug}`} aria-hidden="true">
            <OptimizedImage src={product.media[0].src} alt="" widths={[100, 200, 300]} sizes="(max-width: 760px) 60px, 92px" />
          </div>}
        </a>
      ))}
    </div>
