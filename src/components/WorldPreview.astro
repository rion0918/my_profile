---
import { Image } from "astro:assets";
import preview from "../../public/images/world-preview.jpg";
---
<a class="worldPreview" href="/world" data-world-entry>
  <Image src={preview} widths={[480, 800, 1200, 1680]} sizes="(max-width: 1016px) 100vw, 980px" format="webp" quality={84} alt="" loading="eager" />
  <span class="worldPreviewCaption">
    <strong>3Dの街を歩く</strong>
    <span class="worldPreviewArrow" aria-hidden="true">→</span>
  </span>
</a>
