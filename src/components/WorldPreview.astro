---
import { Image } from "astro:assets";
import preview from "../../public/images/world-preview.jpg";
---
<a class="worldPreview" href="/world" data-world-entry aria-label="3Dの街を歩く">
  <Image src={preview} widths={[180, 360, 540]} sizes="(max-width: 600px) 100px, 180px" width={660} height={408} format="webp" quality={85} alt="作品の館や温泉が並ぶ3Dの街" loading="eager" />
  <span class="worldPreviewCopy"><strong>3Dの街を歩く</strong><span>作品の展示や、温泉のある街を探索できます。</span></span>
  <span class="worldPreviewArrow" aria-hidden="true">→</span>
</a>
