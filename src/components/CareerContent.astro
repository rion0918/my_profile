---
import { career } from "../../lib/portfolio";
---
<div class="careerFlow">
  {career.map((entry, index) => (
    <article class="careerItem">
      <div class="flowMeta">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <time>{entry.period.split(/(?=（)/).map((part, partIndex) => (partIndex === 0 ? part : <span class="periodNote">{part}</span>))}</time>
      </div>
      <div>
        <h3>
          {entry.prefix && <small>{entry.prefix}</small>}
          {entry.title}
          {entry.suffix && <small>{entry.suffix}</small>}
        </h3>
        <p>{entry.description}</p>
        {entry.links && (
          <div class="careerLinks">
            {entry.links.map((link) => (
              <a class="textLink" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
            ))}
          </div>
        )}
      </div>
    </article>
  ))}
</div>
