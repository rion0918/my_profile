---
import Layout from "../../layouts/Layout.astro";
import ModeBar from "../../components/ModeBar.astro";
import ProductContent from "../../components/ProductContent.astro";
import { products, type Product } from "../../../lib/products";
import "../../styles/normal.css";
export function getStaticPaths() {
  return products.map(product => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: Product; }
const { product } = Astro.props;
---
<Layout title={`${product.name} | 橋本怜苑`} ogTitle={`${product.name} | 橋本怜苑`} description={product.summary} ogDescription={product.summary} ogImage={null}>
  <ModeBar />
  <main class="detailPage">
    <a class="textLink" href="/profile#products">← 作品一覧</a>
    <h1>{product.name}</h1>
    <ProductContent product={product} />
  </main>
</Layout>
